# Gerado pelo `qs` na primeira execução (contém paths por máquina).
# Ver https://quickshell.org/docs/guide/install-setup/#language-server
quickshell/.config/quickshell/.qmlls.ini
**/.qmlls.ini
__pycache__/
# Per-machine wallpaper (sourced by hyprpaper.conf and rewritten by the
# wallpaper picker) — must stay out of Git so a wallpaper change never
# dirties the repo.
hypr/.config/hypr/hyprpaper-local.conf
