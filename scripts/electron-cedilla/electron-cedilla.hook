[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = electron*

[Action]
Description = Reapplying ' + c -> ç compose patch to the Electron binary...
When = PostTransaction
# No argument: the script itself resolves every installed /usr/lib/electron*/electron
Exec = /usr/bin/python3 /usr/local/bin/electron-cedilla-patch.py
